NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=OXIUM_DB

ACCESS_TOKEN_SECRET=change-me-at-least-16-chars-long
AUTH_SECRET=change-me-inter-service-payload-signing-secret

USER_SERVICE_URL=http://localhost:5050
EV_MACHINE_SERVICE_URL=http://localhost:5050
TRANSACTION_SERVICE_URL=http://localhost:5050
NOTIFICATION_SERVICE_URL=http://localhost:5050

CORS_ORIGIN=http://localhost:5173

PORT_OCPP_HTTP=6500

# HMAC(secret, clientId) — mobile app connects with …?token=<hex>
MOBILE_WS_SHARED_SECRET=change-me-at-least-16-chars-long

LOG_LEVEL=info
RATE_LIMIT_MAX=2000

# Firebase (omit both to disable push)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_CREDENTIAL_PATH=./firebase-service-account.json
